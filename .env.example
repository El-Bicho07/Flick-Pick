# Django Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Settings (Neon Lakebase Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# TMDB API (Optional - application runs completely standalone without it)
TMDB_API_KEY=

# FlickPick AI RAG Settings
FLICKPICK_AI_ENABLED=true
FLICKPICK_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
FLICKPICK_OLLAMA_MODEL=qwen3:4b
FLICKPICK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Google Gemini API Settings (Optional LLM Provider - set FLICKPICK_LLM_PROVIDER=gemini)
FLICKPICK_GEMINI_API_KEY=
FLICKPICK_GEMINI_MODEL=gemini-2.5-flash
FLICKPICK_AI_REQUEST_TIMEOUT=15

# MongoDB Settings (Optional Chat Logs & User Feedback)
# Local: mongodb://localhost:27017/
# Atlas: mongodb+srv://<username>:<password>@<cluster-host>/flickpick_logs?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=flickpick_logs
MONGODB_TIMEOUT_MS=5000
